parameters:
  level: 2
  tipsOfTheDay: false
  reportUnmatchedIgnoredErrors: false
  drupal:
    drupal_root: '%currentWorkingDirectory%'
  excludePaths:
    - '*/tests/fixtures/*.php'
  ignoreErrors:
    - '#Unsafe usage of new static\(\)#'
    # PHPUnit attributes are for Drupal 11.3+; Drupal 10 (PHPUnit 9) doesn't define them.
    - '#Attribute class PHPUnit\\Framework\\Attributes\\.+ does not exist#'
